<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activity.TestActivity"
    android:background="?attr/backgroundColor">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/backButton"
        style="@style/Widget.Material3.Button.IconButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="4dp"
        android:contentDescription="@string/back"
        app:icon="@drawable/ic_arrow_back"
        app:iconTint="?attr/textColor"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="16dp"
        android:text="@string/learning_tests_title"
        android:textColor="?attr/textColor"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/backButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/backButton"
        app:layout_constraintTop_toTopOf="@id/backButton" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvTests"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginBottom="60dp"
        android:padding="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/backButton"/>

    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/animationView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:background="?attr/backgroundColor"
        android:layout_alignParentBottom="true"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:id="@+id/tests"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="?attr/selectableItemBackgroundBorderless">

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/testIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/graduation24"
                    android:contentDescription="@string/nav_learning"/>

                <com.airbnb.lottie.LottieAnimationView
                    android:id="@+id/testAnimation"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:visibility="gone"/>
            </FrameLayout>

            <TextView
                android:id="@+id/testTest"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nav_learning"
                android:textColor="#7A7A7B"
                android:textSize="12sp"/>
        </LinearLayout>

        <!-- Дуэль -->
        <LinearLayout
            android:id="@+id/duel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="?attr/selectableItemBackgroundBorderless">

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/mainIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/swords24"
                    android:contentDescription="@string/nav_duel" />

                <com.airbnb.lottie.LottieAnimationView
                    android:id="@+id/duelAnimation"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:visibility="gone"/>
            </FrameLayout>

            <TextView
                android:id="@+id/mainTest"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nav_duel"
                android:textColor="#7A7A7B"
                android:textSize="12sp"/>
        </LinearLayout>

        <!-- Рейтинг -->
        <LinearLayout
            android:id="@+id/leaderboard"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="?attr/selectableItemBackgroundBorderless">


            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/cupIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/trophy24"
                    android:contentDescription="@string/nav_rank"/>

                <com.airbnb.lottie.LottieAnimationView
                    android:id="@+id/cupAnimation"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:visibility="gone"/>
            </FrameLayout>

            <TextView
                android:id="@+id/cupTest"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nav_rank"
                android:textColor="#7A7A7B"
                android:textSize="12sp"/>
        </LinearLayout>

        <!-- Профиль -->
        <LinearLayout
            android:id="@+id/profile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="?attr/selectableItemBackgroundBorderless">

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/profileIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/profile24"
                    android:contentDescription="@string/nav_profile"/>

                <com.airbnb.lottie.LottieAnimationView
                    android:id="@+id/profAnimation"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:visibility="gone"/>
            </FrameLayout>

            <TextView
                android:id="@+id/profileTest"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nav_profile"
                android:textColor="#7A7A7B"
                android:textSize="12sp"/>
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
