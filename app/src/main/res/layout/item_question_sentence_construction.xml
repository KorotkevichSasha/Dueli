<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvQuestionText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:textColor="?attr/textColor"
        android:textStyle="bold"/>

    <TextView
        android:id="@+id/tvSentenceParts"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/sentence_word_bank"
        android:textColor="?attr/secondaryTextColor"
        android:gravity="center"
        android:layout_gravity="center"/>

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/containerSelectedWords"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        android:padding="8dp"
        android:background="@drawable/bg_selected_words"
        android:animateLayoutChanges="true"/>

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/containerWordBank"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp"
        android:animateLayoutChanges="true"/>

</LinearLayout>
