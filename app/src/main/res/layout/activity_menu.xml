<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/backgroundColor">



    <LinearLayout
        android:id="@+id/searchOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:background="#F21B2433"
        android:clickable="true"
        android:elevation="48dp"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:indeterminateTint="@color/white"
            android:elevation="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/searching_for_opponent"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:layout_marginTop="16dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelSearch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cancel_duel_search"
            android:textColor="@color/white"
            android:layout_marginTop="24dp"
            app:backgroundTint="@android:color/transparent"
            app:cornerRadius="18dp"
            app:strokeColor="@color/white"
            app:strokeWidth="1dp" />
    </LinearLayout>

    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/animationView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <!-- Кнопка поиска дуэли -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/duelHeroCard"
        android:layout_width="0dp"
        android:layout_height="142dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="16dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="5dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/duelHeroImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/duel_hero_description"
            android:scaleType="centerCrop" />
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnDuel"
        android:layout_width="0dp"
        android:layout_height="72dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="12dp"
        android:text="@string/start_duel_search"
        android:textColor="@android:color/white"
        android:textSize="19sp"
        android:textStyle="bold"
        android:elevation="8dp"
        app:backgroundTint="@color/blue_primary"
        app:cornerRadius="24dp"
        app:icon="@drawable/swords24"
        app:iconGravity="textStart"
        app:iconPadding="14dp"
        app:iconSize="28dp"
        app:iconTint="@color/white"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/duelHeroCard"
        tools:ignore="MissingConstraints" />

    <TextView
        android:id="@+id/duelSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="32dp"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:text="@string/duel_subtitle"
        android:textColor="?attr/secondaryTextColor"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnOfflineDuel" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnOfflineDuel"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="0dp"
        android:layout_height="54dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="8dp"
        android:text="@string/start_offline_duel"
        android:textAllCaps="false"
        android:textSize="16sp"
        app:cornerRadius="18dp"
        app:icon="@drawable/graduation24"
        app:iconTint="@color/blue_primary"
        app:strokeColor="@color/blue_primary"
        app:strokeWidth="1dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnDuel" />

    <TextView
        android:id="@+id/historyTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/duel_history"
        android:textColor="?attr/textColor"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginTop="20dp"
        android:layout_marginStart="20dp"
        app:layout_constraintTop_toBottomOf="@id/duelStatsCard"
        app:layout_constraintStart_toStartOf="parent"/>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/duelStatsCard"
        android:layout_width="0dp"
        android:layout_height="82dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="16dp"
        app:cardBackgroundColor="?attr/cardBackgroundColor"
        app:cardCornerRadius="20dp"
        app:cardElevation="2dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/duelSubtitle">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">
                <TextView android:id="@+id/duelsPlayedValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/value_zero" android:textColor="?attr/textColor" android:textSize="21sp" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/duels_played" android:textColor="?attr/secondaryTextColor" android:textSize="12sp" />
            </LinearLayout>

            <View android:layout_width="1dp" android:layout_height="38dp" android:background="?attr/dividerColor" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">
                <TextView android:id="@+id/duelsWonValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/value_zero" android:textColor="@color/green_primary" android:textSize="21sp" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/duels_won" android:textColor="?attr/secondaryTextColor" android:textSize="12sp" />
            </LinearLayout>

            <View android:layout_width="1dp" android:layout_height="38dp" android:background="?attr/dividerColor" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">
                <TextView android:id="@+id/duelWinRateValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/percentage_zero" android:textColor="@color/blue_primary" android:textSize="21sp" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/duel_win_rate" android:textColor="?attr/secondaryTextColor" android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/duelHistoryRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:clipToPadding="false"
        android:paddingBottom="8dp"
        app:layout_constraintTop_toBottomOf="@id/historyTitle"
        app:layout_constraintBottom_toTopOf="@id/linearLayout2"/>

    <LinearLayout
        android:id="@+id/emptyHistoryContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingVertical="10dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/linearLayout2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/historyTitle">

        <ImageView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:alpha="0.85"
            android:contentDescription="@null"
            android:src="@drawable/swords24"
            app:tint="@color/blue_primary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/empty_duel_history_title"
                android:textColor="?attr/textColor"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:breakStrategy="balanced"
                android:maxLines="3"
                android:text="@string/empty_duel_history_text"
                android:textColor="?attr/secondaryTextColor"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/linearLayout2"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="?attr/backgroundColor"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:id="@+id/tests"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:gravity="center"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/testIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@string/nav_learning"
                    android:src="@drawable/graduation24" />

                <com.airbnb.lottie.LottieAnimationView
                    android:id="@+id/testAnimation"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:visibility="gone" />
            </FrameLayout>

            <TextView
                android:id="@+id/testTest"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nav_learning"
                android:textColor="#7A7A7B"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Дуэль -->
        <LinearLayout
            android:id="@+id/duel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:gravity="center"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/mainIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@string/nav_duel"
                    android:src="@drawable/swords24" />

                <com.airbnb.lottie.LottieAnimationView
                    android:id="@+id/duelAnimation"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:visibility="gone" />
            </FrameLayout>

            <TextView
                android:id="@+id/mainTest"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nav_duel"
                android:textColor="#7A7A7B"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Рейтинг -->
        <LinearLayout
            android:id="@+id/leaderboard"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:gravity="center"
            android:orientation="vertical">


            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/cupIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@string/nav_rank"
                    android:src="@drawable/trophy24" />

                <com.airbnb.lottie.LottieAnimationView
                    android:id="@+id/cupAnimation"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:visibility="gone" />
            </FrameLayout>

            <TextView
                android:id="@+id/cupTest"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nav_rank"
                android:textColor="#7A7A7B"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Профиль -->
        <LinearLayout
            android:id="@+id/profile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:gravity="center"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/profileIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@string/nav_profile"
                    android:src="@drawable/profile24" />

                <com.airbnb.lottie.LottieAnimationView
                    android:id="@+id/profAnimation"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:visibility="gone" />
            </FrameLayout>

            <TextView
                android:id="@+id/profileTest"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nav_profile"
                android:textColor="#7A7A7B"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
