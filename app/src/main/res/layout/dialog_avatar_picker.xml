<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_dialog" android:orientation="vertical" android:padding="24dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
        <com.google.android.material.button.MaterialButton android:id="@+id/closeButton" style="@style/Widget.Material3.Button.IconButton" android:layout_width="48dp" android:layout_height="48dp" android:contentDescription="@string/back" app:icon="@drawable/ic_arrow_back" app:iconTint="?attr/textColor" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/choose_avatar" android:textColor="?attr/textColor" android:textSize="22sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="@string/choose_avatar_subtitle" android:textColor="?attr/secondaryTextColor" android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>
    <GridLayout android:id="@+id/avatarGrid" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:alignmentMode="alignMargins" android:columnCount="5" android:rowCount="2" android:useDefaultMargins="true" />
    <com.google.android.material.checkbox.MaterialCheckBox android:id="@+id/contentPolicyCheck" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/avatar_content_confirmation" android:textColor="?attr/textColor" android:textSize="14sp" />
    <com.google.android.material.button.MaterialButton android:id="@+id/uploadButton" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="58dp" android:layout_marginTop="10dp" android:enabled="false" android:maxLines="1" android:text="@string/upload_own_photo" android:textAllCaps="false" app:autoSizeMaxTextSize="16sp" app:autoSizeMinTextSize="12sp" app:autoSizeStepGranularity="1sp" app:autoSizeTextType="uniform" app:cornerRadius="16dp" app:icon="@drawable/ic_camera" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:gravity="center" android:lineSpacingExtra="2dp" android:text="@string/avatar_safety_notice" android:textColor="?attr/secondaryTextColor" android:textSize="14sp" />
</LinearLayout>
