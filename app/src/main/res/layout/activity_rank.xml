<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"

    android:scrollbars="vertical"
    android:fadeScrollbars="false"
    android:scrollbarSize="4dp"
    android:scrollbarStyle="outsideOverlay"
    android:overScrollMode="never"

    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activity.RankActivity"
    android:background="?attr/backgroundColor">



    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/animationView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>


    <LinearLayout
        android:id="@+id/leaderboardContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:background="?attr/backgroundColor"
        android:padding="16dp"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigation"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Заголовок -->
        <TextView
            android:id="@+id/tvLeaderboardTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/leaderboard_title"
            android:textSize="24sp"
            android:textColor="?attr/textColor"
            android:textStyle="bold"
            android:layout_gravity="center_horizontal"
            android:paddingBottom="16dp"/>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/leagueSummaryCard"
            android:layout_width="match_parent"
            android:layout_height="134dp"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="@color/blue_primary"
            app:cardCornerRadius="22dp"
            app:cardElevation="5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/league_title"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvRankProgress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/rank_first_place"
                    android:textColor="#DDEEFF"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="4dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                        <TextView android:id="@+id/tvRankSummary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textColor="@color/white" android:textSize="22sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/rank_stat" android:textColor="#DDEEFF" android:textSize="12sp" />
                    </LinearLayout>

                    <View android:layout_width="1dp" android:layout_height="34dp" android:background="#55FFFFFF" />

                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                        <TextView android:id="@+id/tvPointsSummary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="@color/white" android:textSize="22sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/points_stat" android:textColor="#DDEEFF" android:textSize="12sp" />
                    </LinearLayout>

                    <View android:layout_width="1dp" android:layout_height="34dp" android:background="#55FFFFFF" />

                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                        <TextView android:id="@+id/tvPlayersSummary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="@color/white" android:textSize="22sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/players_stat" android:textColor="#DDEEFF" android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Отдельный блок для текущего пользователя -->

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <!-- RecyclerView для отображения списка лидеров -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvLeaderboard"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:scrollbars="vertical"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintBottom_toTopOf="@id/userContainer" />

                <LinearLayout
                    android:id="@+id/leaderboardLoading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    app:layout_constraintBottom_toTopOf="@id/userContainer"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <ProgressBar
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:indeterminateTint="@color/blue_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/leaderboard_loading"
                        android:textColor="?attr/secondaryTextColor"
                        android:textSize="14sp" />
                </LinearLayout>

                <!-- Контейнер для текущего пользователя -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/userContainer"
                    android:layout_width="0dp"
                    android:layout_height="51dp"
                    android:background="@drawable/bg_current_user_rank"
                    android:padding="8dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <!-- Ранг пользователя -->
                    <TextView
                        android:id="@+id/tvUserRank"
                        android:layout_width="32dp"
                        android:layout_height="wrap_content"
                        android:textColor="@color/blue_primary"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>

                    <!-- Аватар пользователя -->
                    <de.hdodenhof.circleimageview.CircleImageView
                        android:id="@+id/ivUserAvatar"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/default_profile"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toEndOf="@id/tvUserRank"
                        app:layout_constraintTop_toTopOf="parent"/>

                    <!-- Имя пользователя -->
                    <TextView
                        android:id="@+id/tvUsername"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="8dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/blue_primary"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:layout_constraintBottom_toBottomOf="@id/ivUserAvatar"
                        app:layout_constraintEnd_toStartOf="@id/tvUserPoints"
                        app:layout_constraintStart_toEndOf="@id/ivUserAvatar"
                        app:layout_constraintTop_toTopOf="@id/ivUserAvatar"/>

                    <!-- Очки пользователя -->
                    <TextView
                        android:id="@+id/tvUserPoints"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:minWidth="64dp"
                        android:gravity="end"
                        android:textColor="@color/blue_primary"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:layout_constraintBottom_toBottomOf="@id/ivUserAvatar"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/tvUsername"
                        app:layout_constraintTop_toTopOf="@id/ivUserAvatar"/>

                </androidx.constraintlayout.widget.ConstraintLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </LinearLayout>


    </LinearLayout>


    <LinearLayout
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:background="?attr/backgroundColor"
        android:layout_alignParentBottom="true"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:id="@+id/tests"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="?attr/selectableItemBackgroundBorderless">

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/testIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/graduation24"
                    android:contentDescription="Тесты"/>

                <com.airbnb.lottie.LottieAnimationView
                    android:id="@+id/testAnimation"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:visibility="gone"/>
            </FrameLayout>

            <TextView
                android:id="@+id/testTest"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nav_learning"
                android:textColor="#7A7A7B"
                android:textSize="12sp"/>
        </LinearLayout>

        <!-- Дуэль -->
        <LinearLayout
            android:id="@+id/duel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="?attr/selectableItemBackgroundBorderless">

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/mainIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/swords24"
                    android:contentDescription="Дуэль" />

                <com.airbnb.lottie.LottieAnimationView
                    android:id="@+id/duelAnimation"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:visibility="gone"/>
            </FrameLayout>

            <TextView
                android:id="@+id/mainTest"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nav_duel"
                android:textColor="#7A7A7B"
                android:textSize="12sp"/>
        </LinearLayout>

        <!-- Рейтинг -->
        <LinearLayout
            android:id="@+id/leaderboard"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="?attr/selectableItemBackgroundBorderless">


            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/cupIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/trophy24"
                    android:contentDescription="Рейтинг"/>

                <com.airbnb.lottie.LottieAnimationView
                    android:id="@+id/cupAnimation"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:visibility="gone"/>
            </FrameLayout>

            <TextView
                android:id="@+id/cupTest"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nav_rank"
                android:textColor="#7A7A7B"
                android:textSize="12sp"/>
        </LinearLayout>

        <!-- Профиль -->
        <LinearLayout
            android:id="@+id/profile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="?attr/selectableItemBackgroundBorderless">

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/profileIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/profile24"
                    android:contentDescription="Профиль"/>

                <com.airbnb.lottie.LottieAnimationView
                    android:id="@+id/profAnimation"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:visibility="gone"/>
            </FrameLayout>

            <TextView
                android:id="@+id/profileTest"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nav_profile"
                android:textColor="#7A7A7B"
                android:textSize="12sp"/>
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
