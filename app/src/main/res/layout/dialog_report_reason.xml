<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog"
    android:orientation="vertical"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/bg_report_icon">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_report_flag" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/report_reason_title"
                android:textColor="?attr/textColor"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/report_reason_subtitle"
                android:textColor="?attr/secondaryTextColor"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/reasonAvatarButton"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="22dp"
        android:gravity="start|center_vertical"
        android:textAllCaps="false"
        android:textColor="?attr/textColor"
        android:textSize="16sp"
        app:backgroundTint="?attr/cardBackgroundColor"
        app:cornerRadius="16dp"
        app:strokeColor="?attr/dividerColor" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/reasonNameButton"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="10dp"
        android:gravity="start|center_vertical"
        android:textAllCaps="false"
        android:textColor="?attr/textColor"
        android:textSize="16sp"
        app:backgroundTint="?attr/cardBackgroundColor"
        app:cornerRadius="16dp"
        app:strokeColor="?attr/dividerColor" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/reasonHarassmentButton"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="10dp"
        android:gravity="start|center_vertical"
        android:textAllCaps="false"
        android:textColor="?attr/textColor"
        android:textSize="16sp"
        app:backgroundTint="?attr/cardBackgroundColor"
        app:cornerRadius="16dp"
        app:strokeColor="?attr/dividerColor" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/reasonOtherButton"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="10dp"
        android:gravity="start|center_vertical"
        android:textAllCaps="false"
        android:textColor="?attr/textColor"
        android:textSize="16sp"
        app:backgroundTint="?attr/cardBackgroundColor"
        app:cornerRadius="16dp"
        app:strokeColor="?attr/dividerColor" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/cancelButton"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_gravity="end"
        android:layout_marginTop="10dp"
        android:text="@android:string/cancel"
        android:textAllCaps="false"
        android:textColor="?attr/secondaryTextColor"
        android:textSize="15sp" />
</LinearLayout>
