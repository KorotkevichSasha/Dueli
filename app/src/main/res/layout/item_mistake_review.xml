<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="10dp"
    app:cardBackgroundColor="?attr/backgroundColor" app:cardCornerRadius="18dp" app:strokeColor="?attr/dividerColor" app:strokeWidth="1dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
        <TextView android:id="@+id/mistakeQuestion" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="?attr/textColor" android:textSize="15sp" android:textStyle="bold" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="11dp"
            android:background="@drawable/bg_feedback_incorrect" android:orientation="vertical" android:padding="11dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/your_answer_label"
                android:textColor="?attr/colorError" android:textSize="12sp" android:textStyle="bold" />
            <TextView android:id="@+id/mistakeUserAnswer" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="3dp" android:textColor="?attr/textColor" android:textSize="15sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp"
            android:background="@drawable/bg_feedback_correct" android:orientation="vertical" android:padding="11dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/correct_answer_label"
                android:textColor="@color/green_primary" android:textSize="12sp" android:textStyle="bold" />
            <TextView android:id="@+id/mistakeCorrectAnswer" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="3dp" android:textColor="?attr/textColor" android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
