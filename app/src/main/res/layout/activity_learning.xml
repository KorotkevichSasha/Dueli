<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/backgroundColor"
    android:paddingHorizontal="16dp">

    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/animationView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/learningHeroCard"
        android:layout_width="0dp"
        android:layout_height="132dp"
        android:layout_marginTop="16dp"
        app:cardBackgroundColor="@android:color/transparent"
        app:cardCornerRadius="24dp"
        app:cardElevation="6dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_premium_gradient"
            android:padding="20dp">

            <ImageView
                android:id="@+id/learningHeroIcon"
                android:layout_width="62dp"
                android:layout_height="62dp"
                android:contentDescription="@string/learning_hero_title"
                android:scaleType="centerCrop"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/learningHeroTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="@string/learning_hero_title"
                android:textColor="@color/white"
                android:textSize="21sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/learningHeroIcon"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/learningPoints"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="12dp"
                android:text="@string/learning_points_zero"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold"
                app:layout_constraintStart_toEndOf="@id/learningHeroIcon"
                app:layout_constraintTop_toBottomOf="@id/learningHeroTitle" />

            <TextView
                android:id="@+id/learningTopics"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:text="@string/learning_topics_loading"
                android:textColor="#DDEEFF"
                android:textSize="14sp"
                app:layout_constraintBaseline_toBaselineOf="@id/learningPoints"
                app:layout_constraintStart_toEndOf="@id/learningPoints" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/learningPathCard"
        android:layout_width="0dp"
        android:layout_height="136dp"
        android:layout_marginTop="10dp"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        app:cardBackgroundColor="?attr/cardBackgroundColor"
        app:cardCornerRadius="18dp"
        app:cardElevation="2dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/learningHeroCard">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp">

            <ImageView
                android:id="@+id/learningPathIcon"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_feature_icon"
                android:contentDescription="@null"
                android:padding="8dp"
                android:src="@drawable/ic_smart_review"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/learningPathTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/learning_path_title"
                android:textColor="?attr/textColor"
                android:textSize="17sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toStartOf="@id/learningProgressText"
                android:layout_marginStart="11dp"
                app:layout_constraintStart_toEndOf="@id/learningPathIcon"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/learningProgressText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/learning_progress_zero"
                android:textColor="@color/blue_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                app:layout_constraintBaseline_toBaselineOf="@id/learningPathTitle"
                app:layout_constraintEnd_toEndOf="parent" />

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/learningOverallProgress"
                android:layout_width="0dp"
                android:layout_height="8dp"
                android:layout_marginTop="10dp"
                android:max="100"
                android:progress="0"
                app:indicatorColor="@color/blue_primary"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/learningPathTitle"
                app:trackColor="?attr/backgroundColor"
                app:trackCornerRadius="4dp" />

            <TextView
                android:id="@+id/learningRecommendation"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:maxLines="2"
                android:text="@string/learning_recommendation_loading"
                android:textColor="?attr/secondaryTextColor"
                android:textSize="13sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/learningOverallProgress" />

            <TextView
                android:id="@+id/learningHabit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginTop="4dp"
                android:textColor="@color/blue_primary"
                android:textSize="13sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/learningRecommendation" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>


    <!-- CardView для Listening -->
    <androidx.cardview.widget.CardView
        android:id="@+id/listeningCard"
        android:layout_width="0dp"
        android:layout_height="80dp"
        android:layout_marginTop="10dp"
        app:cardBackgroundColor="?attr/cardBackgroundColor"
        app:cardCornerRadius="12dp"
        app:cardElevation="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/testsCard">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="14dp">

            <ImageView
                android:id="@+id/listeningFeatureIcon"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:contentDescription="@null"
                android:background="@drawable/bg_feature_icon"
                android:padding="10dp"
                android:src="@drawable/ic_headphones"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/blue_primary" />

            <!-- Текст Listening -->
            <TextView
                android:id="@+id/tvListeningTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:text="@string/learning_listening_title"
                android:textColor="?attr/textColor"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toStartOf="@id/listeningArrow"
                app:layout_constraintStart_toEndOf="@id/listeningFeatureIcon"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/learning_listening_subtitle"
                android:textColor="?attr/secondaryTextColor"
                android:textSize="13sp"
                app:layout_constraintEnd_toStartOf="@id/listeningArrow"
                app:layout_constraintStart_toEndOf="@id/listeningFeatureIcon"
                app:layout_constraintTop_toBottomOf="@id/tvListeningTitle" />

            <TextView
                android:id="@+id/listeningArrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/chevron_next"
                android:textColor="@color/blue_primary"
                android:textSize="28sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>

    <!-- CardView для Tests -->
    <androidx.cardview.widget.CardView
        android:id="@+id/testsCard"
        android:layout_width="0dp"
        android:layout_height="80dp"
        android:layout_marginTop="12dp"
        app:cardBackgroundColor="?attr/cardBackgroundColor"
        app:cardCornerRadius="12dp"
        app:cardElevation="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/learningPathCard">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="14dp">

            <ImageView
                android:id="@+id/testsFeatureIcon"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:contentDescription="@null"
                android:background="@drawable/bg_feature_icon"
                android:padding="10dp"
                android:src="@drawable/graduation24"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/blue_primary" />

            <!-- Текст Tests -->
            <TextView
                android:id="@+id/tvTestsTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:text="@string/learning_tests_title"
                android:textColor="?attr/textColor"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toStartOf="@id/testsArrow"
                app:layout_constraintStart_toEndOf="@id/testsFeatureIcon"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/learning_tests_subtitle"
                android:textColor="?attr/secondaryTextColor"
                android:textSize="13sp"
                app:layout_constraintEnd_toStartOf="@id/testsArrow"
                app:layout_constraintStart_toEndOf="@id/testsFeatureIcon"
                app:layout_constraintTop_toBottomOf="@id/tvTestsTitle" />

            <TextView
                android:id="@+id/testsArrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/chevron_next"
                android:textColor="@color/blue_primary"
                android:textSize="28sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>

    <!-- CardView для Vocabulary -->
    <androidx.cardview.widget.CardView
        android:id="@+id/vocabularyCard"
        android:layout_width="0dp"
        android:layout_height="80dp"
        android:layout_marginTop="10dp"
        app:cardBackgroundColor="?attr/cardBackgroundColor"
        app:cardCornerRadius="12dp"
        app:cardElevation="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/listeningCard">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="14dp">

            <ImageView
                android:id="@+id/vocabularyFeatureIcon"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:contentDescription="@null"
                android:background="@drawable/bg_feature_icon"
                android:padding="10dp"
                android:src="@drawable/ic_book"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/blue_primary" />

            <TextView
                android:id="@+id/tvVocabularyTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:text="@string/learning_vocabulary_title"
                android:textColor="?attr/textColor"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toStartOf="@id/vocabularyArrow"
                app:layout_constraintStart_toEndOf="@id/vocabularyFeatureIcon"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/learning_vocabulary_subtitle"
                android:textColor="?attr/secondaryTextColor"
                android:textSize="13sp"
                app:layout_constraintEnd_toStartOf="@id/vocabularyArrow"
                app:layout_constraintStart_toEndOf="@id/vocabularyFeatureIcon"
                app:layout_constraintTop_toBottomOf="@id/tvVocabularyTitle" />

            <TextView
                android:id="@+id/vocabularyArrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/chevron_next"
                android:textColor="@color/blue_primary"
                android:textSize="28sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/learningTipCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:cardBackgroundColor="?attr/cardBackgroundColor"
        app:cardCornerRadius="18dp"
        app:strokeColor="@color/blue_primary"
        app:strokeWidth="1dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/vocabularyCard">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:contentDescription="@null"
                android:padding="6dp"
                android:src="@drawable/ic_lightbulb"
                app:tint="@color/blue_primary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/learning_tip_title"
                    android:textColor="?attr/textColor"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/learningTipText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="@string/learning_tip_text"
                    android:textColor="?attr/secondaryTextColor"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="?attr/backgroundColor"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Тесты -->
        <LinearLayout
            android:id="@+id/tests"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:gravity="center"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/testIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@string/nav_learning"
                    android:src="@drawable/graduation24" />

                <com.airbnb.lottie.LottieAnimationView
                    android:id="@+id/testAnimation"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:visibility="gone" />
            </FrameLayout>

            <TextView
                android:id="@+id/testTest"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nav_learning"
                android:textColor="#7A7A7B"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Дуэль -->
        <LinearLayout
            android:id="@+id/duel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:gravity="center"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/mainIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@string/nav_duel"
                    android:src="@drawable/swords24" />

                <com.airbnb.lottie.LottieAnimationView
                    android:id="@+id/duelAnimation"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:visibility="gone" />
            </FrameLayout>

            <TextView
                android:id="@+id/mainTest"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nav_duel"
                android:textColor="#7A7A7B"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Рейтинг -->
        <LinearLayout
            android:id="@+id/leaderboard"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:gravity="center"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/cupIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@string/nav_rank"
                    android:src="@drawable/trophy24" />

                <com.airbnb.lottie.LottieAnimationView
                    android:id="@+id/cupAnimation"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:visibility="gone" />
            </FrameLayout>

            <TextView
                android:id="@+id/cupTest"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nav_rank"
                android:textColor="#7A7A7B"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Профиль -->
        <LinearLayout
            android:id="@+id/profile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:gravity="center"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/profileIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@string/nav_profile"
                    android:src="@drawable/profile24" />

                <com.airbnb.lottie.LottieAnimationView
                    android:id="@+id/profAnimation"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:visibility="gone" />
            </FrameLayout>

            <TextView
                android:id="@+id/profileTest"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nav_profile"
                android:textColor="#7A7A7B"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
