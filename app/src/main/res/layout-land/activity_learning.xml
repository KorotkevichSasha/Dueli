<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="?attr/backgroundColor">

    <com.airbnb.lottie.LottieAnimationView android:id="@+id/animationView" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout android:layout_width="0dp" android:layout_height="0dp" android:baselineAligned="false"
        android:orientation="horizontal" android:padding="12dp"
        app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toTopOf="@id/linearLayout2"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.92"
            android:orientation="vertical" android:paddingEnd="7dp">
            <com.google.android.material.card.MaterialCardView android:id="@+id/learningHeroCard"
                android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
                app:cardBackgroundColor="@color/blue_primary" app:cardCornerRadius="20dp" app:cardElevation="2dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                    android:gravity="center_vertical" android:orientation="horizontal" android:padding="16dp">
                    <ImageView android:id="@+id/learningHeroIcon" android:layout_width="64dp" android:layout_height="64dp"
                        android:contentDescription="@string/learning_hero_title" android:scaleType="centerCrop" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:layout_marginStart="16dp" android:orientation="vertical">
                        <TextView android:id="@+id/learningHeroTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:text="@string/learning_hero_title" android:textColor="@color/white" android:textSize="22sp" android:textStyle="bold" />
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="horizontal">
                            <TextView android:id="@+id/learningPoints" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/learning_points_zero" android:textColor="@color/white" android:textSize="15sp" android:textStyle="bold" />
                            <TextView android:id="@+id/learningTopics" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="20dp" android:text="@string/learning_topics_loading" android:textColor="#DDEEFF" android:textSize="14sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView android:id="@+id/learningTipCard"
                android:layout_width="match_parent" android:layout_height="96dp" android:layout_marginTop="10dp"
                app:cardBackgroundColor="?attr/cardBackgroundColor" app:cardCornerRadius="18dp" app:cardElevation="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal" android:padding="14dp">
                    <ImageView android:layout_width="38dp" android:layout_height="38dp" android:contentDescription="@null" android:src="@drawable/ic_lightbulb" app:tint="@color/blue_primary" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/learning_tip_title" android:textColor="?attr/textColor" android:textStyle="bold" />
                        <TextView android:id="@+id/learningTipText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:maxLines="2" android:ellipsize="end" android:text="@string/learning_tip_text" android:textColor="?attr/secondaryTextColor" android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.08"
            android:orientation="vertical" android:paddingStart="7dp">

            <FrameLayout android:id="@+id/listeningCard" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:foreground="?attr/selectableItemBackground">
                <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="match_parent" app:cardBackgroundColor="?attr/cardBackgroundColor" app:cardCornerRadius="18dp" app:cardElevation="1dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="16dp">
                        <ImageView android:id="@+id/listeningFeatureIcon" android:layout_width="44dp" android:layout_height="44dp" android:src="@drawable/ic_headphones" android:contentDescription="@null"/>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="14dp" android:orientation="vertical"><TextView android:id="@+id/tvListeningTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/learning_listening_title" android:textColor="?attr/textColor" android:textSize="17sp" android:textStyle="bold"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:text="@string/learning_listening_subtitle" android:textColor="?attr/secondaryTextColor" android:textSize="12sp"/></LinearLayout>
                        <TextView android:id="@+id/listeningArrow" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textColor="@color/blue_primary" android:textSize="28sp"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </FrameLayout>

            <FrameLayout android:id="@+id/testsCard" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginVertical="8dp" android:foreground="?attr/selectableItemBackground">
                <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="match_parent" app:cardBackgroundColor="?attr/cardBackgroundColor" app:cardCornerRadius="18dp" app:cardElevation="1dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="16dp">
                        <ImageView android:id="@+id/testsFeatureIcon" android:layout_width="44dp" android:layout_height="44dp" android:src="@drawable/graduation24" android:contentDescription="@null"/>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="14dp" android:orientation="vertical"><TextView android:id="@+id/tvTestsTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/learning_tests_title" android:textColor="?attr/textColor" android:textSize="17sp" android:textStyle="bold"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:text="@string/learning_tests_subtitle" android:textColor="?attr/secondaryTextColor" android:textSize="12sp"/></LinearLayout>
                        <TextView android:id="@+id/testsArrow" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textColor="@color/blue_primary" android:textSize="28sp"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </FrameLayout>

            <FrameLayout android:id="@+id/vocabularyCard" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:foreground="?attr/selectableItemBackground">
                <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="match_parent" app:cardBackgroundColor="?attr/cardBackgroundColor" app:cardCornerRadius="18dp" app:cardElevation="1dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="16dp">
                        <ImageView android:id="@+id/vocabularyFeatureIcon" android:layout_width="44dp" android:layout_height="44dp" android:src="@drawable/ic_book" android:contentDescription="@null"/>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="14dp" android:orientation="vertical"><TextView android:id="@+id/tvVocabularyTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/learning_vocabulary_title" android:textColor="?attr/textColor" android:textSize="17sp" android:textStyle="bold"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:text="@string/learning_vocabulary_subtitle" android:textColor="?attr/secondaryTextColor" android:textSize="12sp"/></LinearLayout>
                        <TextView android:id="@+id/vocabularyArrow" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textColor="@color/blue_primary" android:textSize="28sp"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout android:id="@+id/linearLayout2" android:layout_width="0dp" android:layout_height="60dp" android:orientation="horizontal" android:background="?attr/backgroundColor" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <LinearLayout android:id="@+id/tests" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical"><FrameLayout android:layout_width="wrap_content" android:layout_height="wrap_content"><ImageView android:id="@+id/testIcon" android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/graduation24"/><com.airbnb.lottie.LottieAnimationView android:id="@+id/testAnimation" android:layout_width="24dp" android:layout_height="24dp" android:visibility="gone"/></FrameLayout><TextView android:id="@+id/testTest" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/nav_learning" android:textColor="#7A7A7B" android:textSize="12sp"/></LinearLayout>
        <LinearLayout android:id="@+id/duel" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:background="?attr/selectableItemBackgroundBorderless"><FrameLayout android:layout_width="wrap_content" android:layout_height="wrap_content"><ImageView android:id="@+id/mainIcon" android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/swords24"/><com.airbnb.lottie.LottieAnimationView android:id="@+id/duelAnimation" android:layout_width="24dp" android:layout_height="24dp" android:visibility="gone"/></FrameLayout><TextView android:id="@+id/mainTest" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/nav_duel" android:textColor="#7A7A7B" android:textSize="12sp"/></LinearLayout>
        <LinearLayout android:id="@+id/leaderboard" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:background="?attr/selectableItemBackgroundBorderless"><FrameLayout android:layout_width="wrap_content" android:layout_height="wrap_content"><ImageView android:id="@+id/cupIcon" android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/trophy24"/><com.airbnb.lottie.LottieAnimationView android:id="@+id/cupAnimation" android:layout_width="24dp" android:layout_height="24dp" android:visibility="gone"/></FrameLayout><TextView android:id="@+id/cupTest" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/nav_rank" android:textColor="#7A7A7B" android:textSize="12sp"/></LinearLayout>
        <LinearLayout android:id="@+id/profile" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:background="?attr/selectableItemBackgroundBorderless"><FrameLayout android:layout_width="wrap_content" android:layout_height="wrap_content"><ImageView android:id="@+id/profileIcon" android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/profile24"/><com.airbnb.lottie.LottieAnimationView android:id="@+id/profAnimation" android:layout_width="24dp" android:layout_height="24dp" android:visibility="gone"/></FrameLayout><TextView android:id="@+id/profileTest" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/nav_profile" android:textColor="#7A7A7B" android:textSize="12sp"/></LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
