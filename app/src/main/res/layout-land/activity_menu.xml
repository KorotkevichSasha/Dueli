<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="?attr/backgroundColor">

    <com.airbnb.lottie.LottieAnimationView android:id="@+id/animationView"
        android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout android:id="@+id/menuWideContent"
        android:layout_width="0dp" android:layout_height="0dp" android:orientation="horizontal"
        android:baselineAligned="false" android:padding="12dp"
        app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toTopOf="@id/linearLayout2"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">

        <androidx.core.widget.NestedScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:paddingEnd="7dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

            <com.google.android.material.card.MaterialCardView android:id="@+id/duelHeroCard"
                android:layout_width="match_parent" android:layout_height="104dp"
                app:cardCornerRadius="18dp" app:cardElevation="2dp">
                <ImageView android:id="@+id/duelHeroImage" android:layout_width="match_parent"
                    android:layout_height="match_parent" android:contentDescription="@string/duel_hero_description"
                    android:scaleType="fitCenter" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/duelEconomyCard"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="6dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardBackgroundColor="?attr/cardBackgroundColor"
                app:cardCornerRadius="16dp"
                app:cardElevation="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="12dp">
                    <ImageView android:layout_width="24dp" android:layout_height="24dp" android:contentDescription="@string/rush_sparks" android:src="@drawable/ic_rush_spark" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="7dp" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:id="@+id/rushBalanceText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="25/25" android:textColor="?attr/textColor" android:textSize="15sp" android:textStyle="bold" />
                        <TextView android:id="@+id/rushTimerText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:text="@string/rush_sparks_ready" android:textColor="?attr/secondaryTextColor" android:textSize="10sp" />
                    </LinearLayout>
                    <ImageView android:layout_width="22dp" android:layout_height="22dp" android:contentDescription="@null" android:src="@drawable/ic_gold_coin" />
                    <TextView android:id="@+id/goldBalanceText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="5dp" android:text="@string/value_zero" android:textColor="?attr/textColor" android:textSize="15sp" android:textStyle="bold" />
                    <ImageButton android:id="@+id/refillRushButton" android:layout_width="36dp" android:layout_height="36dp" android:layout_marginStart="5dp" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/rush_store_title" android:padding="8dp" android:src="@drawable/add" app:tint="@color/blue_primary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <FrameLayout android:id="@+id/duelActionContainer"
                android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="8dp">
                <com.google.android.material.button.MaterialButton android:id="@+id/btnDuel"
                    android:layout_width="match_parent" android:layout_height="match_parent" android:paddingEnd="68dp"
                    android:text="@string/start_duel_search" android:textSize="16sp" android:textStyle="bold"
                    app:backgroundTint="@color/blue_primary" app:cornerRadius="17dp"
                    app:icon="@drawable/swords24" app:iconGravity="textStart" app:iconPadding="8dp" app:iconSize="22dp" />
                <LinearLayout android:layout_width="50dp" android:layout_height="30dp"
                    android:layout_gravity="end|center_vertical" android:layout_marginEnd="10dp"
                    android:background="@drawable/bg_duel_cost_badge" android:clickable="false"
                    android:contentDescription="@string/duel_search_cost_accessibility" android:focusable="false"
                    android:elevation="12dp" android:gravity="center" android:importantForAccessibility="yes" android:orientation="horizontal">
                    <ImageView android:layout_width="15dp" android:layout_height="15dp" android:contentDescription="@null"
                        android:importantForAccessibility="no" android:src="@drawable/ic_rush_spark" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginStart="3dp" android:importantForAccessibility="no"
                        android:text="@string/duel_search_cost_value" android:textColor="@android:color/white"
                        android:textSize="13sp" android:textStyle="bold" />
                </LinearLayout>
            </FrameLayout>

            <com.google.android.material.button.MaterialButton android:id="@+id/btnOfflineDuel"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="6dp"
                android:text="@string/start_offline_duel" android:textAllCaps="false"
                app:cornerRadius="16dp" app:strokeColor="@color/blue_primary" app:strokeWidth="1dp" />

            <TextView android:id="@+id/duelSubtitle" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginVertical="5dp" android:gravity="center"
                android:maxLines="2" android:text="@string/duel_subtitle" android:textColor="?attr/secondaryTextColor"
                android:textSize="12sp" />

            <com.google.android.material.card.MaterialCardView android:id="@+id/duelStatsCard"
                android:layout_width="match_parent" android:layout_height="64dp"
                app:cardBackgroundColor="?attr/cardBackgroundColor" app:cardCornerRadius="16dp" app:cardElevation="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                    android:gravity="center" android:orientation="horizontal">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                            <TextView android:id="@+id/duelsPlayedValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/value_zero" android:textColor="?attr/textColor" android:textSize="18sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/duels_played" android:textColor="?attr/secondaryTextColor" android:textSize="11sp" />
                    </LinearLayout>
                    <View android:layout_width="1dp" android:layout_height="32dp" android:background="?attr/dividerColor" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                            <TextView android:id="@+id/duelsWonValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/value_zero" android:textColor="@color/green_primary" android:textSize="18sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/duels_won" android:textColor="?attr/secondaryTextColor" android:textSize="11sp" />
                    </LinearLayout>
                    <View android:layout_width="1dp" android:layout_height="32dp" android:background="?attr/dividerColor" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                            <TextView android:id="@+id/duelWinRateValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/percentage_zero" android:textColor="@color/blue_primary" android:textSize="18sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/duel_win_rate" android:textColor="?attr/secondaryTextColor" android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:orientation="vertical" android:paddingStart="7dp">
            <TextView android:id="@+id/historyTitle" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:paddingBottom="6dp"
                android:text="@string/duel_history" android:textColor="?attr/textColor"
                android:textSize="20sp" android:textStyle="bold" />
            <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
                <androidx.recyclerview.widget.RecyclerView android:id="@+id/duelHistoryRecyclerView"
                    android:layout_width="match_parent" android:layout_height="match_parent" android:clipToPadding="false" />
                <LinearLayout android:id="@+id/emptyHistoryContainer" android:layout_width="match_parent"
                    android:layout_height="match_parent" android:gravity="center" android:orientation="vertical">
                    <ImageView android:layout_width="52dp" android:layout_height="52dp" android:alpha="0.7"
                        android:contentDescription="@null" android:src="@drawable/swords24" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="6dp" android:text="@string/empty_duel_history_text"
                        android:textColor="?attr/secondaryTextColor" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout android:id="@+id/linearLayout2" android:layout_width="0dp" android:layout_height="60dp"
        android:orientation="horizontal" android:background="?attr/backgroundColor"
        app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <LinearLayout android:id="@+id/tests" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:background="?attr/selectableItemBackgroundBorderless">
            <FrameLayout android:layout_width="wrap_content" android:layout_height="wrap_content"><ImageView android:id="@+id/testIcon" android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/graduation24"/><com.airbnb.lottie.LottieAnimationView android:id="@+id/testAnimation" android:layout_width="24dp" android:layout_height="24dp" android:visibility="gone"/></FrameLayout>
            <TextView android:id="@+id/testTest" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/nav_learning" android:textColor="#7A7A7B" android:textSize="12sp"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/duel" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
            <FrameLayout android:layout_width="wrap_content" android:layout_height="wrap_content"><ImageView android:id="@+id/mainIcon" android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/swords24"/><com.airbnb.lottie.LottieAnimationView android:id="@+id/duelAnimation" android:layout_width="24dp" android:layout_height="24dp" android:visibility="gone"/></FrameLayout>
            <TextView android:id="@+id/mainTest" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/nav_duel" android:textColor="#7A7A7B" android:textSize="12sp"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/leaderboard" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:background="?attr/selectableItemBackgroundBorderless">
            <FrameLayout android:layout_width="wrap_content" android:layout_height="wrap_content"><ImageView android:id="@+id/cupIcon" android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/trophy24"/><com.airbnb.lottie.LottieAnimationView android:id="@+id/cupAnimation" android:layout_width="24dp" android:layout_height="24dp" android:visibility="gone"/></FrameLayout>
            <TextView android:id="@+id/cupTest" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/nav_rank" android:textColor="#7A7A7B" android:textSize="12sp"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/profile" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:background="?attr/selectableItemBackgroundBorderless">
            <FrameLayout android:layout_width="wrap_content" android:layout_height="wrap_content"><ImageView android:id="@+id/profileIcon" android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/profile24"/><com.airbnb.lottie.LottieAnimationView android:id="@+id/profAnimation" android:layout_width="24dp" android:layout_height="24dp" android:visibility="gone"/></FrameLayout>
            <TextView android:id="@+id/profileTest" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/nav_profile" android:textColor="#7A7A7B" android:textSize="12sp"/>
        </LinearLayout>
    </LinearLayout>

    <FrameLayout android:id="@+id/searchOverlay" android:layout_width="match_parent" android:layout_height="match_parent"
        android:background="#E6000000" android:visibility="gone" android:elevation="20dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical">
            <ProgressBar android:id="@+id/progressBar" android:layout_width="64dp" android:layout_height="64dp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/searching_for_opponent" android:textColor="@color/white" android:textSize="18sp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnCancelSearch" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="@string/cancel_duel_search" />
        </LinearLayout>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
