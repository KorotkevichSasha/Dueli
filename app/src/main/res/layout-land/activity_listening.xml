<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/backgroundColor"
    android:paddingHorizontal="16dp">

    <LinearLayout
        android:id="@+id/listeningHeader"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/backButton"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/back"
            app:icon="@drawable/ic_arrow_back"
            app:iconTint="?attr/textColor" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/listening_screen_title"
            android:textColor="?attr/textColor"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/listening_instruction"
            android:textColor="?attr/secondaryTextColor"
            android:textSize="14sp" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/listeningContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="8dp"
        app:layout_constraintBottom_toTopOf="@id/listeningActions"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/listeningHeader">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal"
            android:paddingVertical="6dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="7dp"
                android:layout_weight="1"
                app:cardBackgroundColor="?attr/cardBackgroundColor"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeColor="#251687F8"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <ImageButton
                        android:id="@+id/playAudioIcon"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/listening_play_sentence"
                        android:padding="5dp"
                        android:src="@drawable/record" />

                    <ProgressBar
                        android:id="@+id/questionLoading"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:contentDescription="@string/listening_loading"
                        android:indeterminateTint="@color/blue_primary" />

                    <TextView
                        android:id="@+id/playbackStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/listening_loading"
                        android:textColor="?attr/textColor"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/speedLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/speed_default"
                        android:textColor="@color/blue_primary"
                        android:textSize="14sp" />

                    <SeekBar
                        android:id="@+id/speedSeekBar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/listening_speed_description"
                        android:max="100"
                        android:progress="50" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="7dp"
                android:layout_weight="1"
                app:cardBackgroundColor="?attr/cardBackgroundColor"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeColor="#251687F8"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <ImageButton
                        android:id="@+id/recordAudioIcon"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/listening_record_voice"
                        android:padding="5dp"
                        android:src="@drawable/microphone" />

                    <TextView
                        android:id="@+id/recordingStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/listening_tap_microphone"
                        android:textColor="?attr/textColor"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/recognizedText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:minHeight="36dp"
                        android:text="@string/listening_nothing_recorded"
                        android:textColor="@color/blue_primary"
                        android:textSize="16sp" />

                    <LinearLayout
                        android:id="@+id/listeningResultCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_listening_result"
                        android:orientation="vertical"
                        android:padding="12dp"
                        android:visibility="gone">

                        <TextView android:id="@+id/feedbackText" android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:gravity="center" android:textColor="?attr/textColor" android:textSize="14sp" android:textStyle="bold" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
                            android:text="@string/listening_your_answer_label" android:textColor="?attr/secondaryTextColor" android:textSize="11sp" android:textStyle="bold" />
                        <TextView android:id="@+id/submittedAnswerText" android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="2dp" android:textColor="?attr/textColor" android:textSize="14sp" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
                            android:text="@string/listening_correct_phrase_label" android:textColor="@color/green_primary" android:textSize="11sp" android:textStyle="bold" />
                        <TextView android:id="@+id/correctAnswerText" android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="2dp" android:textColor="?attr/textColor" android:textIsSelectable="true" android:textSize="15sp" android:textStyle="bold" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/replayCorrectAnswerButton"
                            style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="44dp"
                            android:layout_marginTop="8dp" android:text="@string/listening_replay_correct" android:textAllCaps="false"
                            android:textSize="12sp" app:cornerRadius="14dp" app:strokeColor="@color/blue_primary" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/listeningActions"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:paddingBottom="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/submitButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:enabled="false"
            android:text="@string/submit_answer" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/nextListeningButton"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:textSize="16sp"
            android:textAllCaps="false"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/listening_next_sentence"
            android:visibility="gone" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
